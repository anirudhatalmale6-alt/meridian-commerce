# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env -- it is in .gitignore.
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_dev?schema=public"

# Separate database used by `npm test`. The test suite TRUNCATES tables, so this
# must never point at a database you care about.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_test?schema=public"

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to send credentialed requests.
# There is no wildcard fallback: an unlisted origin is refused, because
# `Access-Control-Allow-Origin: *` and cookies are mutually exclusive anyway.
CORS_ORIGINS="http://localhost:5173"

# Signing secrets. Generate with: openssl rand -base64 48
# The two MUST differ -- reusing one secret means a refresh token is accepted
# as an access token.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Access token lifetime (short by design -- the refresh cookie does the work).
ACCESS_TOKEN_TTL="15m"
# Refresh cookie lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Set to "true" only when serving over HTTPS; it adds Secure to the auth cookies.
COOKIE_SECURE=false
# Use "none" only for a cross-site frontend on HTTPS, otherwise "lax".
COOKIE_SAMESITE=lax

# Bank details printed on the checkout confirmation and in the order email copy.
BANK_ACCOUNT_NAME="Acme Commerce Ltd"
BANK_ACCOUNT_NUMBER="00000000"
BANK_SORT_CODE="00-00-00"
BANK_IBAN=""
BANK_SWIFT=""
